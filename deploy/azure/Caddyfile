{
	email {$ACME_EMAIL}
	admin off
}

{$WEB_HOSTNAME} {
	encode zstd gzip
	reverse_proxy oauth2-proxy:4180 {
		flush_interval -1
		transport http {
			keepalive 30s
			response_header_timeout 4h
		}
	}
}

# This listener is private to the Compose network. oauth2-proxy authenticates
# the request, then this hop adds the proof header expected by pdf_web.
:8080 {
	reverse_proxy pdf-web:8000 {
		header_up X-PDF-Web-Proxy-Secret {$PDF_WEB_PROXY_SECRET}
		flush_interval -1
		transport http {
			keepalive 30s
			response_header_timeout 4h
		}
	}
}
