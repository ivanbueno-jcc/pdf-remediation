                                            "pds_struct_elem"
                                        ]
                                    },
                                    "statement": "$if"
                                }
                            ]
                        }
                    }
                },
                {
                    "ext": "",
                    "flags": 0,
                    "name": "adjacent_type",
                    "type": "string",
                    "value": "Note"
                },
                {
                    "ext": "",
                    "flags": 0,
                    "name": "skip_tags",
                    "type": "string",
                    "value": "^(Document|Part|Art|Sect|Div|BlockQuote|Caption|TOC|TOCI|Index|NonStruct|Private)$"
                },
                {
                    "ext": "",
