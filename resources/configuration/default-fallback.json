{
    "actions": [
        {
            "comment": "Remove TrapNet and PrinterMark annotations",
            "name": "delete_annot",
            "params": [
                {
                    "name": "annot_types",
                    "value": "^TrapNet|PrinterMark$"
                }
            ],
            "title": "Delete Annotations"
        },
        {
            "comment": "AutoTag the document - keep existing tags, no standard attributes, preflight mode",
            "name": "add_tags",
            "params": [
                {
                    "name": "template",
                    "value": ""
                },
                {
                    "name": "preflight",
                    "value": false
                },
                {
                    "name": "standard_attrs",
                    "value": "false"
                },
                {
                    "name": "sequential_headings",
                    "value": "false"
                },
                {
                    "name": "overwrite",
                    "value": true
                }
            ],
            "title": "AutoTag"
        },
        {
            "comment": "Delete empty tags that are not headings or LBody",
            "name": "delete_tags",
            "params": [
                {
                    "name": "tag_names",
                    "value": {
                        "template": {
                            "tag_update": [
                                {
                                    "query": {
                                        "$and": [
                                            {
                                                "$0_tag_type": {
                                                    "$regex": "^(?!H$|H\\d$|TH$|TD$|TR$|LBody$).*"
                                                }
                                            },
                                            {
                                                "$0_has_content": "false"
                                            }
                                        ],
                                        "param": [
                                            "pds_struct_elem"
                                        ]
                                    },
                                    "statement": "$if"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "tag_content",
                    "value": "none"
                }
            ],
            "title": "Delete Tags"
        },
        {
            "comment": "Delete tags with only whitespace content",
            "name": "delete_tags",
            "params": [
                {
                    "name": "tag_names",
                    "value": {
                        "template": {
                            "tag_update": [
                                {
                                    "query": {
                                        "$and": [
                                            {
                                                "$0_text": {
                                                    "$regex": "^ *$"
                                                }
                                            }
                                        ],
                                        "param": [
                                            "pds_struct_elem"
                                        ]
                                    },
                                    "statement": "$if"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "tag_content",
                    "value": "artifact"
                }
            ],
            "title": "Delete Tags"
        },
        {
            "comment": "Add missing Unicode mappings to text elements",
            "name": "add_missing_unicode",
            "title": "Add Missing Unicodes"
        },
        {
            "comment": "Fix the display document title to match the actual document title",
            "name": "set_display_doc_title",
            "title": "Fix Display Document Title"
        },
        {
